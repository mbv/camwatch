# Copy to .env (gitignored) and fill in real values. docker-compose.yml reads
# these and passes them through as container env vars; configs/camwatch.docker.yaml
# references them as ${TELEGRAM_BOT_TOKEN} etc. instead of hardcoding secrets.
#
# Rotate any value that was ever committed or left in a shared file — these
# are live credentials, not placeholders to leave stale.

TELEGRAM_BOT_TOKEN=123456789:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
TELEGRAM_CHAT_ID=-1000000000000
TELEGRAM_API_ID=0
TELEGRAM_API_HASH=00000000000000000000000000000000
